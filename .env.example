# ForgeOps configuration.
# Create your .env with:  cd backend && uv run python -m forgeops.devtools.envfile
# Empty secrets below are generated automatically. Never commit .env.

FORGEOPS_ENV=development
FORGEOPS_SECRET_KEY=
FORGEOPS_ADMIN_EMAIL=admin@forgeops.local
FORGEOPS_ADMIN_PASSWORD=
FORGEOPS_WORKSPACE_NAME=My workspace

# ForgeOps' own database. Use a Supabase project's "Session pooler" connection string
# (Connect -> Session pooler), starting with postgresql+asyncpg:// and with special
# characters in the password URL-encoded (@ -> %40, * -> %2A, # -> %23).
# Leave empty to use the optional local Docker Postgres below.
DATABASE_URL=
# Private schema for ForgeOps tables (kept out of Supabase's public Data API schema).
DATABASE_SCHEMA=forgeops

# Optional local Postgres (docker compose --profile local-db up -d)
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=
POSTGRES_DB=forgeops
POSTGRES_PORT=5433

# LLM (OpenRouter) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
FORGEOPS_MODEL_SUPERVISOR=anthropic/claude-sonnet-5
FORGEOPS_MODEL_SPECIALIST=anthropic/claude-haiku-4.5
FORGEOPS_MODEL_RCA=anthropic/claude-sonnet-5

# Where the knowledge vault search index is stored (git-ignored)
KNOWLEDGE_DATA_DIR=../.forgeops-data/knowledge
